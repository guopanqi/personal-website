---
interface Props {
  placement: 'header' | 'footer';
}

const { placement } = Astro.props;
---

<div class={`sketch-margin sketch-margin--${placement}`} data-sketch-margin aria-hidden="true">
  {
    placement === 'header' ? (
      <svg viewBox="0 0 1000 128" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
        {/* Curiosity and imagination: wandering pencil marks rather than a row of icons. */}
        <g class="pencil faint">
          <path class="sketch-stroke sketch-stroke--1" pathLength="100" d="M-10 76 Q48 69 90 83 T195 77 M214 24 Q255 35 284 22" />
          <path class="sketch-stroke sketch-stroke--2" pathLength="100" d="M304 96 C345 86 377 102 412 83 S474 51 504 61" />
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M729 92 C779 79 807 103 854 85 S937 68 1010 82" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M81 36 l5 -4 m-2 18 l-7 3 M888 27 l5 -7 m9 26 l9 -1 M460 26 l4 -9" />
        </g>
        <g class="pencil graphite">
          <path class="sketch-stroke sketch-stroke--1" pathLength="100" d="M123 41 l35 -3 3 39 -37 2z M129 46 l21 -2 m-20 12 l24 -2 m-24 13 l17 -2 M151 38 l9 9" />
          <path class="sketch-stroke sketch-stroke--2" pathLength="100" d="M210 66 a12 12 0 1 0 24 0 a12 12 0 1 0 -24 0 M231 75 l12 12 m-26 -25 q5 -5 10 -2" />
          <path class="sketch-stroke sketch-stroke--2" pathLength="100" d="M276 65 Q302 43 330 65 T380 63 Q399 51 414 65" />
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M422 68 c-15 -12 11 -30 24 -13 s-13 36 -29 18 s7 -44 33 -21" />
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M535 41 L559 57 587 31 619 49 642 30 M559 57 L584 78 619 49" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M704 69 q14 -16 28 0 q-14 16 -28 0z M716 69 a4 4 0 1 0 8 0 a4 4 0 1 0 -8 0" />
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M776 45 C784 33 806 33 813 46 C820 60 805 64 804 75 h-13 C791 65 778 62 776 45z M792 80 h12 M795 85 h7 m-5 -35 l3 8 4 -8" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M865 77 l39 -29 7 7 -39 29z M865 77 l7 7 -12 6z m41 -40 l4 -7" />
        </g>
        <g class="pencil ochre">
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M490 93 q3 -9 8 -3 q4 4 -3 10 m0 5 v2" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M672 30 l3 9 9 3 -9 3 -3 9 -3 -9 -9 -3 9 -3z" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M930 34 l2 7 7 2 -7 2 -2 7 -2 -7 -7 -2 7 -2z" />
          <circle class="sketch-mark" cx="535" cy="41" r="1.8" />
          <circle class="sketch-mark" cx="559" cy="57" r="1.6" />
          <circle class="sketch-mark" cx="587" cy="31" r="1.8" />
          <circle class="sketch-mark" cx="619" cy="49" r="1.6" />
          <circle class="sketch-mark" cx="642" cy="30" r="1.6" />
          <circle class="sketch-mark" cx="584" cy="78" r="1.5" />
        </g>
      </svg>
    ) : (
      <svg viewBox="0 0 1000 136" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
        {/* Computing, science and art: loosely spaced sketches, not a schematic grid. */}
        <g class="pencil faint">
          <path class="sketch-stroke sketch-stroke--1" pathLength="100" d="M-15 91 Q57 103 101 87 M170 109 Q226 99 275 109" />
          <path class="sketch-stroke sketch-stroke--2" pathLength="100" d="M330 69 C364 53 382 95 421 80 S485 47 516 70" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M724 113 C768 101 814 117 858 101 S930 92 1015 99" />
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M273 30 l5 -7 m8 21 l9 -3 M871 22 l4 -8 m14 18 l8 -5" />
        </g>
        <g class="pencil graphite">
          {/* Small terminal with an imperfect hand-drawn outline. */}
          <path class="sketch-stroke sketch-stroke--1" pathLength="100" d="M111 45 Q111 40 116 40 L190 42 L192 90 Q190 95 185 95 L114 93 Q110 90 111 85 Z M111 54 L190 55 M122 69 l8 6 -8 6 M140 82 l15 0" />
          <path class="sketch-stroke sketch-stroke--2" pathLength="100" d="M123 48 h1 m7 0 h1 m7 0 h1" />
          {/* An unfinished circuit path, deliberately not aligned to a grid. */}
          <path class="sketch-stroke sketch-stroke--2" pathLength="100" d="M258 85 H290 V67 H320 V91 L350 91" />
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M290 67 V51 M320 91 V107" />
          {/* A few molecular bonds connect the scientific theme without a textbook diagram. */}
          <path class="sketch-stroke sketch-stroke--2" pathLength="100" d="M452 59 L476 72 L475 98 L452 109 L429 96 L428 72 Z M476 72 L498 60 L520 74 M475 98 L497 111" />
          {/* One experimental curve rather than a large calibrated coordinate plot. */}
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M579 105 Q594 90 607 94 T634 66 T660 78 T700 49" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M575 57 l0 48 l69 0" />
          {/* Art palette and a tiny angled brush, sharing the same loose pencil language. */}
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M778 78 C774 61 792 44 813 44 C836 45 854 62 849 82 C846 97 833 102 821 96 C815 92 811 97 813 103 C814 111 808 115 799 110 C790 104 780 94 778 78 Z" />
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M855 105 L891 66 L897 72 L863 112 Z M855 105 L863 112 L853 117 Z" />
        </g>
        <g class="pencil ochre">
          <path class="sketch-stroke sketch-stroke--4" pathLength="100" d="M546 36 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3z" />
          <path class="sketch-stroke sketch-stroke--3" pathLength="100" d="M741 40 q8 -7 15 0 m-13 6 q6 -4 11 0" />
          <circle class="sketch-mark" cx="258" cy="85" r="1.8" />
          <circle class="sketch-mark" cx="290" cy="67" r="1.8" />
          <circle class="sketch-mark" cx="320" cy="91" r="1.8" />
          <circle class="sketch-mark" cx="350" cy="91" r="1.8" />
          <circle class="sketch-mark" cx="451" cy="82" r="1.8" />
          <circle class="sketch-mark" cx="795" cy="70" r="2" />
          <circle class="sketch-mark" cx="815" cy="60" r="2" />
          <circle class="sketch-mark" cx="827" cy="79" r="2" />
        </g>
      </svg>
    )
  }
</div>

<style>
  .sketch-margin {
    width: 100%;
    overflow: hidden;
    pointer-events: none;
    flex-shrink: 0;
    color: #74685b;
  }

  .sketch-margin--header { height: 110px; }
  .sketch-margin--footer { height: 118px; margin-top: auto; }

  .sketch-margin svg { display: block; width: 100%; height: 100%; }

  .pencil {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .graphite { opacity: 0.58; }
  .faint { opacity: 0.24; }
  .ochre { color: #ad8657; opacity: 0.72; }
  .ochre circle { fill: currentColor; stroke: none; }

  .sketch-stroke { stroke-dasharray: 100; stroke-dashoffset: 0; }
  :global(html.sketch-intro) .sketch-stroke { stroke-dashoffset: 100; }
  :global(html.sketch-intro) .sketch-mark { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.sketch-intro) .sketch-margin.is-drawing .sketch-stroke {
      animation: pencil-draw 1.25s cubic-bezier(0.25, 0.6, 0.36, 1) both;
    }
    :global(html.sketch-intro) .sketch-margin.is-drawing .sketch-stroke--2 { animation-delay: 0.22s; }
    :global(html.sketch-intro) .sketch-margin.is-drawing .sketch-stroke--3 { animation-delay: 0.48s; }
    :global(html.sketch-intro) .sketch-margin.is-drawing .sketch-stroke--4 { animation-delay: 0.68s; }
    :global(html.sketch-intro) .sketch-margin.is-drawing .sketch-mark {
      transform-box: fill-box;
      transform-origin: center;
      animation: pencil-pop 0.42s ease-out 1.25s both;
    }
  }

  @keyframes pencil-draw {
    from { stroke-dashoffset: 100; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes pencil-pop {
    from { opacity: 0; transform: scale(0.4); }
    to { opacity: 1; transform: scale(1); }
  }

  @media (max-width: 700px) {
    .sketch-margin--header { height: 76px; }
    .sketch-margin--footer { height: 84px; }
    .sketch-margin svg {
      position: relative;
      left: 50%;
      width: max(100%, 750px);
      transform: translateX(-50%);
    }
  }
</style>

<script>
  // Each margin draws on entering the viewport, but only on a page marked
  // for an intro by BaseLayout (first visit in the tab, or every Home load).
  if (document.documentElement.classList.contains('sketch-intro')) {
    const margins = document.querySelectorAll('[data-sketch-margin]');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-drawing');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.12 });
      margins.forEach((margin) => observer.observe(margin));
    } else {
      margins.forEach((margin) => margin.classList.add('is-drawing'));
    }
  }
</script>
