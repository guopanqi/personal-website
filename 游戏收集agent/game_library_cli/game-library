#!/usr/bin/env bash
# Portable runner for the game-library CLI.
#
# Why this exists: `uv run --project . game-library ...` works fine on the
# maintainer's Mac, but breaks in the Linux sandbox that Claude's scheduled
# "Gamer520 每日更新" task runs in, for two independent reasons:
#
#   1. .venv/bin/python3 is a symlink baked in on macOS (arm64 darwin) and
#      points at a path that doesn't exist on Linux, so the venv's own
#      launcher is unusable there.
#   2. `uv sync` / `uv pip install` need to fetch wheels from
#      files.pythonhosted.org, and in that sandbox those downloads are
#      throttled to ~10KB/s — a full dependency install can take 10+
#      minutes and blows through per-command timeouts.
#
# Fix: skip `uv run` and its network-dependent sync entirely. .venv's
# site-packages already contains every dependency as pure-Python (installed
# once, normally, on the Mac) plus a Linux aarch64 build of the one compiled
# extension that matters (pydantic_core) sitting *alongside* the macOS
# build — see `python3 -m pip download` note in README.md. Any CPython 3.12
# interpreter, on either platform, will pick the matching binary
# automatically based on its own platform tag, so we just need *a* 3.12
# interpreter and PYTHONPATH pointed at src/ + site-packages. No sync, no
# network calls to PyPI, no timeouts.
#
# This script works unmodified on macOS too (it's just a faster path than
# `uv run` there, since it skips dependency resolution).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SITE="$DIR/.venv/lib/python3.12/site-packages"
SRC="$DIR/src"

if [ ! -d "$SITE" ] || [ ! -d "$SRC" ]; then
    echo "game-library: expected venv at $SITE and src at $SRC — run 'uv sync --project \"$DIR\"' once on a machine with normal network access." >&2
    exit 1
fi

find_python() {
    # 1) A 3.12 interpreter already on PATH.
    if command -v python3.12 >/dev/null 2>&1; then
        command -v python3.12
        return 0
    fi
    # 2) A uv-managed 3.12 interpreter already installed.
    if command -v uv >/dev/null 2>&1; then
        if py="$(uv python find 3.12 2>/dev/null)"; then
            echo "$py"
            return 0
        fi
        # 3) Not installed yet: fetch just the interpreter (fast, ~28MB,
        #    unlike a full dependency sync) and retry.
        if uv python install 3.12 >/dev/null 2>&1; then
            if py="$(uv python find 3.12 2>/dev/null)"; then
                echo "$py"
                return 0
            fi
        fi
    fi
    return 1
}

PY="$(find_python || true)"
if [ -z "${PY:-}" ]; then
    echo "game-library: no Python 3.12 interpreter found and 'uv python install 3.12' failed (no network?)." >&2
    exit 1
fi

export PYTHONPATH="$SRC:$SITE${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m game_library_cli.cli "$@"
